local function draw_menu()
  ui.win_grab=nil
  local e=ease_out(ui.appear); if e<0.01 then return end
  theme.opacity=e*((cfg.ui_opacity or 100)/100)
  local x,y,w=ui.x,ui.y,ui.w
  local tab=SCHEMA[ui.tab] or SCHEMA[1]
  local cx=x+SIDEBAR_W
  local cw=w-SIDEBAR_W
  local ctop=y+TOPBAR_H
  local ng=#tab.groups
  local ncol=ng>1 and 2 or 1
  local colw=(cw-PAD*2-GUT*(ncol-1))/ncol
  local colx={cx+PAD, cx+PAD+colw+GUT}

  local placed=ui.placed
  if not placed then placed={}; ui.placed=placed end
  local coly=ui.coly
  if not coly then coly={0,0}; ui.coly=coly end
  coly[1]=0; coly[2]=0
  local pn=0
  for _,g in ipairs(tab.groups) do
    local gh=30; for _,it in ipairs(g.items) do if row_visible(it) then gh=gh+row_h(it) end end
    local c=(coly[1]<=coly[2]) and 1 or 2
    if c>ncol then c=ncol end
    pn=pn+1
    local pl=placed[pn]
    if not pl then pl={}; placed[pn]=pl end
    pl.g=g; pl.c=c; pl.oy=coly[c]; pl.h=gh
    coly[c]=coly[c]+gh+GUT
  end
  for i=pn+1,#placed do placed[i]=nil end
  local contentH=math.max(coly[1],coly[2]); if contentH>0 then contentH=contentH-GUT end
  local sideH=6+#SCHEMA*26
  ui.h=approach("winh", TOPBAR_H+math.max(contentH,sideH,110)+PAD, 18)
  local h=ui.h
  SNOW.update(48,w,h)

  for i=4,1,-1 do draw.RectFilled(x-i*2.5, y-i*1.5, w+i*5, h+i*4, {0,0,0,0.09*theme.opacity}, theme.round+i*2) end
  draw.RectFilled(x,y,w,h, {theme.base[1],theme.base[2],theme.base[3],0.94*theme.opacity}, theme.round)
  draw.RectFilled(x+theme.round,y,SIDEBAR_W,h-TOPBAR_H, {theme.base2[1],theme.base2[2],theme.base2[3],0.5*theme.opacity}, 0)
  grad_v(x+theme.round,y,w-theme.round*2,TOPBAR_H,
    {theme.panel_hi[1],theme.panel_hi[2],theme.panel_hi[3],0.34*theme.opacity},
    {theme.panel[1],theme.panel[2],theme.panel[3],0.12*theme.opacity}, 48)
  draw.Rect(x,y,w,h, a(theme.line,0.95), theme.round, 1)
  draw.Rect(x+3,y+3,w-6,h-6, a(theme.line,0.22), theme.round, 1)
  draw.Line(x+theme.round, y+TOPBAR_H, x+w-theme.round, y+TOPBAR_H, a(theme.line,0.6), 1)
  draw.Line(x+SIDEBAR_W, y+TOPBAR_H, x+SIDEBAR_W, y+h-theme.round, a(theme.line,0.5), 1)
  draw.RectFilled(x+theme.round, y, w-theme.round*2, 2, a(mix(theme.accent,theme.accent2,0.5), 0.92*e), 0)
  corners(x,y,w,h, 18, a(mix(theme.accent,theme.accent2,0.5), 0.95*e), 2, a(mix(theme.accent,theme.accent2,0.5), 0.5*e))

  local lw=ts("Ego",17)
  draw.Text(x+PAD,y+11,"Ego", a(theme.text,1),17)
  local dx,dy=x+PAD+lw+11, y+19
  if draw.PolyFilled then pcall(draw.PolyFilled, {{dx,dy-4},{dx+4,dy},{dx,dy+4},{dx-4,dy}}, a(theme.accent,1))
  else draw.RectFilled(dx-3,dy-3,6,6, a(theme.accent,1), 1) end
  tmid(dx+11, y, TOPBAR_H, "Framebreak", a(theme.sub,1), 12)
  trt(x+w-PAD,y+12,16,"v1.0", a(theme.faint,1),10)

  local sy=ctop+6
  for i,tab2 in ipairs(SCHEMA) do
    local label=string.lower(tab2.name); local ty=sy+(i-1)*26
    local hot=inside(x+8,ty,SIDEBAR_W-16,24) and interactable()
    if hot and ui.m.click then ui.tab=i; ui.m.click=false end
    local act=approach("tab"..i,(ui.tab==i) and 1 or 0,18)
    if act>0.01 then
      draw.RectFilled(x+8,ty,SIDEBAR_W-16,24, a(theme.accent, 0.12*act), 2)
      local wq={{x+8,ty},{x+11,ty},{x+15,ty+24},{x+12,ty+24}}
      if draw.PolyFilled then pcall(draw.PolyFilled, wq, a(theme.accent,act)) else draw.RectFilled(x+8,ty,3,24, a(theme.accent,act), 0) end
      local qx, qy = x+SIDEBAR_W-19, ty+12
      for k=0,2 do
        draw.RectFilled(qx+k*2, qy-4+k*2, 1.4,1.4, a(theme.accent,act*0.8),0)
        draw.RectFilled(qx+k*2, qy+4-k*2, 1.4,1.4, a(theme.accent,act*0.8),0)
      end
    end
    tmid(x+18,ty,24,label, a(mix(theme.faint,theme.text,math.max(act, hot and 0.5 or 0)),1),12)
  end

  local secn=0
  for _,pl in ipairs(placed) do
    local g=pl.g; local gx=colx[pl.c] or colx[1]; local gy=ctop+pl.oy
    secn=secn+1
    local num=string.format("%02d",secn)
    local nw=ts(num,10)
    draw.RectFilled(gx,gy, nw+7, 13, a(theme.accent,0.16), 2)
    draw.Text(gx+4, gy+2, num, a(theme.accent,0.95), 10)
    local caps=string.upper(g.name); local hw=ts(caps,11)
    draw.Text(gx+nw+13, gy+1, caps, a(theme.faint,1), 11)
    draw.Line(gx+nw+hw+21, gy+9, gx+colw, gy+9, a(theme.line,0.5), 1)
    local iy=gy+18
    for _,it in ipairs(g.items) do
      if row_visible(it) then local f=WI[it.t]; if f then f(it,gx,iy,colw) end iy=iy+row_h(it) end
    end
  end
  if ui.m.click and not ui.drag and not ui.picker and inside(x,y,w,h) then
    ui.win_grab={ox=ui.m.x-x,oy=ui.m.y-y}
  end
  picker_draw()
  SNOW.draw(x,y,w,h,theme.opacity)
end

local function update_input()
  ui.m.x,ui.m.y=mouse_pos()
  local d=ekey(0x01)
  ui.m.click=d and not ui.m.was
  ui.m.down=d; ui.m.was=d
  if not d and ui.drag and ui.drag.k~="slider" then ui.drag=nil end
  if ui.drag and ui.drag.k=="win" then
    local sw,sh=scr()
    ui.x=clamp(ui.m.x-ui.drag.ox,0,math.max(0,sw-ui.w))
    ui.y=clamp(ui.m.y-ui.drag.oy,0,math.max(0,sh-ui.h))
  end
  -- HUD panels drag by absolute screen position. run_hud starts the drag with a
  -- hud_* key and this applies it while the button is held.
  local dk=ui.drag and ui.drag.k
  if dk and string.sub(dk,1,4)=="hud_" then
    local sw,sh=scr()
    cfg[dk.."_x"]=clamp(ui.m.x-ui.drag.ox,0,math.max(0,sw))
    cfg[dk.."_y"]=clamp(ui.m.y-ui.drag.oy,0,math.max(0,sh))
    cfg_dirty=true
  end
  local held=ekey(bind.menu_key or 0xA1)
  if held and not ui.menu_edge then ui.open=not ui.open; ui.picker=nil; ui.capture=nil end
  ui.menu_edge=held

  local ek=bind.esp_toggle or 0
  local eh=(ek~=0) and ekey(ek) or false
  if eh and not ui.esp_edge and not ui.capture then cfg.esp_on=not cfg.esp_on; cfg_dirty=true end
  ui.esp_edge=eh

  local ak=bind.aim_toggle or 0
  local ah=(ak~=0) and ekey(ak) or false
  if ah and not ui.aim_edge and not ui.capture then cfg.aim_on=not cfg.aim_on; cfg_dirty=true end
  ui.aim_edge=ah

  if ui.capture then
    if not ui.capture_ok then if not ekey(0x01) then ui.capture_ok=true end return end
    if ekey(0x1B) then bind[ui.capture]=0; cfg_dirty=true; ui.capture=nil; return end
    for vk=0x01,0xFE do if vk~=0x1B and ekey(vk) then bind[ui.capture]=vk; cfg_dirty=true; ui.capture=nil; return end end
  end
end

-- =========================================================================
-- PLAYER / VIEW HELPERS
-- =========================================================================
local function getfield(o,k) return o[k] end

local V={frame=-1}
local function view()
  local v=V
  if v.frame==FRAME then return v end
  v.frame=FRAME
  local lp
  if entity and entity.GetLocalPlayer then
    local ok,r=pcall(entity.GetLocalPlayer); if ok then lp=r end
  end
  v.lp=lp
  local cx,cy,cz,lx,ly,lz,fov,cpos,clook
  if camera then
    local ok,r=pcall(camera.GetPosition)
    if ok and r then cpos=r; cx,cy,cz=r.X,r.Y,r.Z end
    ok,r=pcall(camera.GetLookVector)
    if ok and r then clook=r; lx,ly,lz=r.X,r.Y,r.Z end
    ok,r=pcall(camera.GetFov)
    if ok then fov=r end
  end
  if type(fov)~="number" or fov<10 or fov>170 then fov=70 end
  v.cpos,v.clook=cpos,clook
  v.cx,v.cy,v.cz=cx,cy,cz
  v.lx,v.ly,v.lz=lx,ly,lz
  v.fov=fov
  local sw,sh=scr()
  v.sw,v.sh=sw,sh
  v.mx,v.my=sw*0.5,sh*0.5
  return v
end

local PL={frame=-1,list=nil}
local function players()
  local c=PL
  if c.frame~=FRAME then
    c.frame=FRAME
    local ok,r=pcall(entity.GetPlayers)
    c.list=(ok and type(r)=="table") and r or nil
  end
  return c.list
end

local function charof(p)
  local ok,c=pcall(getfield,p,"Character")
  if ok and c then return c end
  local ok2,g=pcall(getfield,p,"GetCharacter")
  if ok2 and type(g)=="function" then local ok3,r=pcall(g,p); if ok3 then return r end end
end

local function phealth(p)
  local ok,r=pcall(getfield,p,"Health"); if ok then return tonumber(r) or 0 end
  return 0
end

local function pmaxhealth(p)
  local ok,r=pcall(getfield,p,"MaxHealth"); if ok then return tonumber(r) or 100 end
  return 100
end

-- =========================================================================
-- ESP
-- =========================================================================
-- Joint chains. Neck, LShoulder, RShoulder, LHip and RHip are synthetic joints built
-- in build_rec from real part positions; the rest are R15 part centres.
local SKEL_PATHS={
  {"Head","Neck","UpperTorso","LowerTorso"},
  {"LShoulder","Neck","RShoulder"},
  {"LShoulder","LeftUpperArm","LeftLowerArm","LeftHand"},
  {"RShoulder","RightUpperArm","RightLowerArm","RightHand"},
  {"LHip","LowerTorso","RHip"},
  {"LHip","LeftUpperLeg","LeftLowerLeg","LeftFoot"},
  {"RHip","RightUpperLeg","RightLowerLeg","RightFoot"},
}

-- ---- target discovery -----------------------------------------------------
-- Does not depend on entity.GetPlayers(). Targets come from three sources,
-- merged by instance address and rebuilt twice a second:
--   1. entity cache (full-featured when it works)
--   2. game.Players -> Player.Character
--   3. any Humanoid anywhere in Workspace (bots/NPCs, or characters a mode
--      parents somewhere unusual such as Workspace.Arenas.*)
local PART_NAMES={"Torso","Head","UpperTorso","LowerTorso","HumanoidRootPart",
  "LeftUpperArm","LeftLowerArm","LeftHand","RightUpperArm","RightLowerArm","RightHand",
  "LeftUpperLeg","LeftLowerLeg","LeftFoot","RightUpperLeg","RightLowerLeg","RightFoot"}
local TG={t=-1e9,list={}}
local WS={list={}}            -- Workspace humanoid models found by the sliced scan
local TGC={}                  -- per-character target cache keyed by address

local function addr_of(o)
  if o==nil then return nil end
  local ok,a=pcall(getfield,o,"Address")
  if ok and type(a)=="number" then return a end
end

local function inst_pos(part)
  if not part then return nil end
  local ok,p=pcall(getfield,part,"Position")
  if ok and p then return p end
  local okc,cf=pcall(getfield,part,"CFrame")
  if okc and cf then
    local okp,pp=pcall(getfield,cf,"Position")
    if okp and pp then return pp end
  end
end

local function build_target(char,name,pl,ent,src)
  local tg={char=char,name=name or "?",pl=pl,ent=ent,src=src,parts={}}
  for i=1,#PART_NAMES do
    local n=PART_NAMES[i]
    local ok,pt=pcall(char.FindFirstChild,char,n)
    if ok and pt then tg.parts[n]=pt end
  end
  local okh,hum=pcall(char.FindFirstChildOfClass,char,"Humanoid")
  if okh and hum then tg.hum=hum end
  pcall(function()
    local hi=char:FindFirstChild("HeldItem")
    if hi then local k=hi:GetChildren(); if k and k[1] then tg.held=k[1].Name end end
    if not tg.held then local tl=char:FindFirstChildOfClass("Tool"); if tl then tg.held=tl.Name end end
  end)
  return tg
end

-- the main-menu avatar display model must never get ESP or be aimed at
local function is_lobby_avatar(inst)
  local o=inst
  for _=1,5 do
    if not o then return false end
    local ok,n=pcall(getfield,o,"Name")
    if ok and type(n)=="string" and n:lower():gsub("[^%w]","")~=nil
       and n:lower():gsub("[^%w]",""):find("lobbyavatar",1,true) then return true end
    local okp,par=pcall(getfield,o,"Parent")
    if not okp then return false end
    o=par
  end
  return false
end

-- True while the local player is standing in the main-menu lobby. The lobby is
-- a fixed area (Workspace.Lobby, with a LobbyCollision part), so we check whether
-- our root part is inside it. Fails open: if anything can't be read, returns false.
local LOBBY={part=nil,t=-1e9}
local function in_lobby()
  local ok,res=pcall(function()
    -- the descendant search is slow, so the part is cached and re-found at most every 5s
    local part=LOBBY.part
    local okv,valid=false,false
    if part then okv,valid=pcall(utility.IsValid,part) end
    if not (okv and valid) then
      part=nil
      local t=now()
      if t-LOBBY.t>=15 then
        LOBBY.t=t
        local lobby=game.Workspace:FindFirstChild("Lobby")
        if lobby then part=lobby:FindFirstDescendant("LobbyCollision") end
      end
      LOBBY.part=part
    end
    if not part then return false end
    local ch=game.LocalPlayer.Character
    local hrp=ch and ch:FindFirstChild("HumanoidRootPart")
    local pp,hp=inst_pos(part),inst_pos(hrp)
    if not (pp and hp) then return false end
    local dx,dy,dz=hp.X-pp.X,hp.Y-pp.Y,hp.Z-pp.Z
    local oks,sz=pcall(function() local z=part.Size; return {z.X,z.Y,z.Z} end)
    if oks and sz and sz[1] and sz[3] then
      return math.abs(dx)<=sz[1]*0.5+20 and math.abs(dz)<=sz[3]*0.5+20 and math.abs(dy)<=200
    end
    return math.sqrt(dx*dx+dz*dz)<250 and math.abs(dy)<200
  end)
  return ok and res==true
end

-- Bot/NPC discovery. A single GetDescendants over the whole Workspace is one long
-- call and shows up as a freeze every few seconds, so the tree is walked
-- breadth-first in ~1ms slices per frame instead. Only Models and Folders are
-- descended into (parts never hold characters). A full pass then restarts after
-- a short pause, and the finished list replaces the old one in one step.
local SCAN={q={},i=1,found={},t=-1e9,active=false}
local SCAN_CLASSES={Model=true,Folder=true}
local HEAVY={}   -- containers with lots of children (map geometry): never descended into again
local function ws_step()
  local t0=utility.GetTime()
  if not SCAN.active then
    if t0-SCAN.t<1.5 then return end
    SCAN.q={game.Workspace}; SCAN.i=1; SCAN.found={}; SCAN.active=true
  end
  local deadline=t0+0.001
  local q=SCAN.q
  while SCAN.i<=#q do
    local idx=SCAN.i
    local node=q[idx]; SCAN.i=idx+1
    local na=idx>1 and addr_of(node) or nil
    if not (na and HEAVY[na]) then
      local ok,kids=pcall(node.GetChildren,node)
      if ok and kids then
        local nk=#kids
        local heavy=(idx>1 and nk>250)
        if heavy and na then HEAVY[na]=true end
        local has_hum=false
        for k=1,nk do
          local kid=kids[k]
          local okc,cn=pcall(getfield,kid,"ClassName")
          if okc then
            if cn=="Humanoid" then has_hum=true
            elseif SCAN_CLASSES[cn] and not heavy then q[#q+1]=kid end
          end
        end
        if has_hum then
          local okn,nm=pcall(getfield,node,"Name")
          if not (okn and (nm=="Rig" or nm=="StarterCharacter")) then
            SCAN.found[#SCAN.found+1]={inst=node,a=na or addr_of(node),name=okn and nm or "?"}
          end
        end
      end
    end
    if utility.GetTime()>=deadline then return end
  end
  WS.list=SCAN.found; SCAN.active=false; SCAN.t=utility.GetTime()
end

local function gather(v)
  local t=now()
  if t-TG.t<0.5 then return TG.list end
  TG.t=t
  TG.lobby=in_lobby()
  local out,seen={}, {}
  local ncache={}
  local lpaddr
  pcall(function() lpaddr=addr_of(game.LocalPlayer.Character) end)
  if not lpaddr and v.lp then lpaddr=addr_of(charof(v.lp)) end
  -- map every way a model can be named (username, display name, user id) to its Player
  local pmap={}
  pcall(function()
    local pls=game.Players:GetChildren()
    for i=1,#pls do
      local pl=pls[i]
      local okn,nm=pcall(getfield,pl,"Name")
      local okd,dn=pcall(getfield,pl,"DisplayName")
      local oku,uid=pcall(getfield,pl,"UserId")
      if okn and type(nm)=="string" then pmap[nm:lower()]=pl end
      if okd and type(dn)=="string" and dn~="" then pmap[dn:lower()]=pl end
      if oku and tonumber(uid) then pmap[string.format("%d",math.floor(tonumber(uid)))]=pl end
    end
  end)
  local function push(char,name,pl,ent,s,a)
    if not char then return end
    a=a or addr_of(char)
    if not a or a==lpaddr or seen[a] then return end
    seen[a]=true
    local c=TGC[a]
    if c and c.lav then ncache[a]=c; return end
    if not c and is_lobby_avatar(char) then ncache[a]={lav=true,t=t}; return end
    if not pl and type(name)=="string" then
      local m=pmap[name:lower()]
      if m then pl=m; local ok,real=pcall(getfield,m,"Name"); if ok and type(real)=="string" then name=real end end
    end
    local c=TGC[a]
    local tg
    if c and c.tg and t-c.t<2 then
      tg=c.tg; tg.name=name or tg.name; tg.pl=pl; tg.ent=ent; tg.src=s
    else
      tg=build_target(char,name,pl,ent,s); tg.a=a
      c={tg=tg,t=t-math.random()*1.5}   -- staggered so rebuilds never bunch up
    end
    ncache[a]=c
    out[#out+1]=tg
  end
  local el=players()
  if el then
    for i=1,#el do
      local p=el[i]
      local okl,isl=pcall(getfield,p,"IsLocal")
      if not (okl and isl) then
        local okn,nm=pcall(getfield,p,"Name")
        local okp,pl=pcall(getfield,p,"Player")
        pcall(push,charof(p),okn and nm or "?",okp and pl or nil,p,"ent")
      end
    end
  end
  pcall(function()
    local list=game.Players:GetChildren()
    for i=1,#list do
      local pl=list[i]
      local ch=pl.Character
      if ch then push(ch,pl.Name,pl,nil,"players") end
    end
  end)
  for i=1,#WS.list do
    local m=WS.list[i]
    local okv,valid=pcall(utility.IsValid,m.inst)
    if okv and valid then push(m.inst,m.name,nil,nil,"workspace",m.a) end
  end
  TG.list=out; TGC=ncache
  return out
end

-- ---- per-frame records ----------------------------------------------------
-- One record per target per frame, shared by ESP and aimbot, so both always
-- agree on where a player is. The box is built from the character's real part
-- positions (head and feet), so it follows hero scale and body proportions
-- instead of using fixed offsets or GetBounds (which includes the held item,
-- accessories and effects and is what made the old box messy).
local REC={frame=-1,list={}}

local BOX_PARTS={HumanoidRootPart=true,UpperTorso=true,LowerTorso=true,Torso=true,Head=true,LeftFoot=true,RightFoot=true}
local function put_joint(bones,pool,name,x,y,z)
  local sx,sy,ok=draw.WorldToScreen(x,y,z)
  if not ok then return end
  local e=pool[name]
  if not e then e={}; pool[name]=e end
  e[1]=sx; e[2]=sy
  bones[name]=e
end

local function build_rec(tg,v)
  local p=tg.ent
  if p then
    local okl,isl=pcall(getfield,p,"IsLocal")
    if okl and isl then return nil end
    if p.IsAlive==false then return nil end
  end
  local parts=tg.parts
  -- 1. root part only: distance decides whether anything else is read at all
  local hname=(parts.HumanoidRootPart and "HumanoidRootPart") or (parts.UpperTorso and "UpperTorso")
    or (parts.LowerTorso and "LowerTorso") or (parts.Torso and "Torso")
  if not hname then return nil end
  local hrp=inst_pos(parts[hname])
  if not hrp then return nil end
  local d=0
  if v.cx then
    local dx,dy,dz=hrp.X-v.cx,hrp.Y-v.cy,hrp.Z-v.cz
    d=math.sqrt(dx*dx+dy*dy+dz*dz)
  end
  local esp_r=cfg.esp_on and (cfg.esp_maxdist or 20000) or -1
  local aim_r=cfg.aim_on and (cfg.aim_range or 20000) or -1
  local want_esp=d<=esp_r
  local want_aim=d<=aim_r
  if not (want_esp or want_aim) then return nil end

  -- 2. health
  local hp,mhp
  if p then hp=phealth(p); mhp=pmaxhealth(p)
  elseif tg.hum then
    local ok1,h=pcall(getfield,tg.hum,"Health"); local ok2,m=pcall(getfield,tg.hum,"MaxHealth")
    hp=ok1 and tonumber(h) or nil; mhp=ok2 and tonumber(m) or nil
  end
  if not p and hp and hp<=0 then return nil end
  if not mhp or mhp<=0 then mhp=100 end

  -- 3. box parts. All tables below are owned by the target and reused every frame,
  -- so a frame allocates almost nothing and the garbage collector has nothing to hitch on.
  local wpos=tg.wpos
  if not wpos then wpos={}; tg.wpos=wpos end
  for k in pairs(wpos) do wpos[k]=nil end
  wpos[hname]=hrp
  for n in pairs(BOX_PARTS) do
    if n~=hname then
      local pt=parts[n]
      if pt then local pp=inst_pos(pt); if pp then wpos[n]=pp end end
    end
  end
  if wpos.Torso then
    wpos.UpperTorso=wpos.UpperTorso or wpos.Torso
    wpos.LowerTorso=wpos.LowerTorso or wpos.Torso
  end
  local rec=tg.rec
  if not rec then rec={}; tg.rec=rec end
  rec.tg=tg; rec.p=p; rec.hp=hp; rec.mhp=mhp; rec.wpos=wpos; rec.d=d
  rec.box=nil; rec.bones=nil

  if want_esp then
    local hd=wpos.Head
    local lf,rf=wpos.LeftFoot,wpos.RightFoot
    local footY
    if lf and rf then footY=math.min(lf.Y,rf.Y) elseif lf then footY=lf.Y elseif rf then footY=rf.Y end
    local topY,botY
    if hd and footY and hd.Y>footY+0.5 then
      local H=hd.Y-footY
      topY=hd.Y+0.14*H
      botY=footY-0.05*H
    else
      topY=hd and (hd.Y+0.8) or (hrp.Y+2.7)
      botY=hrp.Y-3.1
    end
    local tx,ty,tok=draw.WorldToScreen(hrp.X,topY,hrp.Z)
    local fx,fy,fok=draw.WorldToScreen(hrp.X,botY,hrp.Z)
    if tok and fok then
      local h=fy-ty
      if h>=4 then
        local w=h*0.48
        local bt=tg.boxt
        if not bt then bt={}; tg.boxt=bt end
        bt.bx=(tx+fx)*0.5-w*0.5; bt.by=ty; bt.bw=w; bt.bh=h
        rec.box=bt
      end
    end
  end

  -- 4. remaining body parts, only when the skeleton, head dot or aimbot needs them
  if want_aim or (want_esp and (cfg.esp_skel or cfg.esp_headdot)) then
    for n,pt in pairs(parts) do
      if not BOX_PARTS[n] then
        local pp=inst_pos(pt)
        if pp then wpos[n]=pp end
      end
    end
    local bones=tg.bones
    if not bones then bones={}; tg.bones=bones; tg.pool={} end
    local pool=tg.pool
    for k in pairs(bones) do bones[k]=nil end
    for n,pp in pairs(wpos) do
      local sx,sy,ok=draw.WorldToScreen(pp.X,pp.Y,pp.Z)
      if ok then
        local e=pool[n]
        if not e then e={}; pool[n]=e end
        e[1]=sx; e[2]=sy
        bones[n]=e
      end
    end
    rec.bones=bones
    if want_esp and cfg.esp_skel then
      -- Part centres sit mid-limb, so a line through them starts at the chest and
      -- elbows instead of the joints. Build neck, shoulders and hips from the body
      -- height (head to feet) so the skeleton follows scale and looks anatomical.
      local hd,lf,rf=wpos.Head,wpos.LeftFoot,wpos.RightFoot
      local fy=(lf and rf and math.min(lf.Y,rf.Y)) or (lf and lf.Y) or (rf and rf.Y)
      local H=4.4
      if hd and fy and hd.Y>fy+0.5 then H=hd.Y-fy end
      local o=0.13*H
      if hd then put_joint(bones,pool,"Neck",hd.X,hd.Y-o,hd.Z) end
      local q=wpos.LeftUpperArm;  if q then put_joint(bones,pool,"LShoulder",q.X,q.Y+o,q.Z) end
      q=wpos.RightUpperArm;       if q then put_joint(bones,pool,"RShoulder",q.X,q.Y+o,q.Z) end
      q=wpos.LeftUpperLeg;        if q then put_joint(bones,pool,"LHip",q.X,q.Y+o,q.Z) end
      q=wpos.RightUpperLeg;       if q then put_joint(bones,pool,"RHip",q.X,q.Y+o,q.Z) end
    end
  end
  return rec
end

local function build_recs(v)
  if REC.frame==FRAME then return REC.list end
  REC.frame=FRAME
  ws_step()
  local list=gather(v)
  local out={}
  for i=1,#list do
    local ok,rec=pcall(build_rec,list[i],v)
    if ok and rec then out[#out+1]=rec end
  end
  REC.list=out
  return out
end

-- ---- drawing --------------------------------------------------------------
local TH={}
local function text_h(sz)
  local h=TH[sz]
  if not h then local _,hh=ts("0",sz); h=hh; TH[sz]=h end
  return h
end

local function esp_rec(rec,v)
  local box=rec.box
  if not box or rec.d>(cfg.esp_maxdist or 20000) then return end
  local bx,by,bw,bh=box.bx,box.by,box.bw,box.bh
  local p,tg,d=rec.p,rec.tg,rec.d
  local cx=bx+bw*0.5
  local c_box=col.c_box or {0.45,0.78,1,1}
  local c_skel=col.c_enemy or {0.95,0.35,0.4,1}
  local c_name=col.c_name or {1,1,1,1}
  local c_dist=col.c_dist or {0.87,0.93,1,1}
  local c_weap=col.c_weapon or c_name
  local c_tr=col.c_tracer or c_box
  local tsz=cfg.esp_textsize or 12
  local th=text_h(tsz)
  local PAD=3

  -- Every element below is anchored to the box rectangle (which is always computed),
  -- never to the box drawing itself, so they sit in the same place with Box on or off.
  if cfg.esp_tracer then pcall(draw.Line, v.mx, v.sh, cx, by+bh, c_tr, 1) end
  if cfg.esp_box then
    if (cfg.esp_boxstyle or 1)==1 then pcall(draw.CornerBox, bx, by, bw, bh, c_box)
    else pcall(draw.Rect, bx, by, bw, bh, c_box, 0, 1) end
  end

  -- left of the box: health bar, with the percentage beside the bar at fill height
  if rec.hp then
    if cfg.esp_hp then pcall(draw.HealthBar, bx-6, by, bh, rec.hp, rec.mhp) end
    if cfg.esp_hptext then
      local frac=clamp(rec.hp/rec.mhp,0,1)
      local s=math.floor(frac*100).."%"
      local hsz=math.max(9,tsz-2)
      local hh=text_h(hsz)
      local tw=ts(s,hsz)
      local tx=bx-(cfg.esp_hp and 9 or 4)-tw
      local ty=clamp(by+bh*(1-frac)-hh*0.5, by, by+bh-hh)
      draw.Text(tx, ty, s, c_dist, hsz)
    end
  end

  local bones=rec.bones
  if cfg.esp_skel and bones then
    for i=1,#SKEL_PATHS do
      local path=SKEL_PATHS[i]
      local prev
      for j=1,#path do
        local e=bones[path[j]]
        if e and prev then pcall(draw.Line, prev[1], prev[2], e[1], e[2], c_skel, 1.5) end
        prev=e
      end
    end
  end
  if cfg.esp_headdot and bones and bones.Head then
    pcall(draw.Circle, bones.Head[1], bones.Head[2], math.max(2,bh*0.065), c_skel, 16, 1.5)
  end

  -- above the box: name
  local nm=tg.name
  if cfg.esp_name and nm and nm~="" and (tg.pl or not nm:match("^%d+$")) then
    local key=tsz..nm
    if tg.nwk~=key then tg.nwk=key; tg.nw=ts(nm,tsz) end
    draw.Text(cx-tg.nw*0.5, by-th-PAD, nm, c_name, tsz)
  end

  -- below the box: distance, then held item
  local ly=by+bh+PAD
  if cfg.esp_dist then
    local dv=math.floor(d)
    if tg.dv~=dv or tg.dk~=tsz then tg.dv=dv; tg.dk=tsz; tg.ds=dv.." m"; tg.dw=ts(tg.ds,tsz) end
    draw.Text(cx-tg.dw*0.5, ly, tg.ds, c_dist, tsz)
    ly=ly+th+1
  end
  if cfg.esp_weapon then
    local tool=tg.held
    if p then local okt,tn=pcall(getfield,p,"ToolName"); if okt and tn and tn~="" then tool=tn end end
    if tool and tool~="" then
      if tg.tn~=tool or tg.tk~=tsz then tg.tn=tool; tg.tk=tsz; tg.tw=ts(tool,tsz) end
      draw.Text(cx-tg.tw*0.5, ly, tool, c_weap, tsz)
    end
  end
end

local function run_esp(v)
  local recs=build_recs(v)
  if cfg.esp_on and not TG.lobby then
    for i=1,#recs do
      pcall(esp_rec,recs[i],v)
    end
  end
end

-- =========================================================================
-- AIMBOT
-- =========================================================================
local AIM_BONE_NAMES={"Head","UpperTorso","HumanoidRootPart","LeftUpperArm","RightUpperArm","LeftUpperLeg","RightUpperLeg"}
local CLOSEST_BONES={"Head","UpperTorso","LowerTorso","HumanoidRootPart"}
local AIML={target=nil,x=nil,y=nil,bone=nil}
local SILENT={on=false}
local function eff_fov()
  if cfg.aim_mode==2 then return cfg.aim_fovm or 100 end
  return cfg.aim_fov or 40
end
pcall(math.randomseed, os.time())
-- Hit chance: a roll decides whether silent aim is applied. It is re-rolled every
-- 0.15s and whenever the target changes, so a shot is redirected with roughly
-- the chosen probability instead of the whole burst being all-or-nothing.
local HC={ok=true,t=-1e9,a=nil}
local function hit_roll(rec)
  local hc=cfg.aim_hc or 100
  if hc>=100 then HC.ok=true; return true end
  local t=now()
  if rec.tg.a~=HC.a or t-HC.t>=0.15 then
    HC.a=rec.tg.a; HC.t=t
    HC.ok=(math.random()*100)<hc
  end
  return HC.ok
end

local function aim_point(rec,v)
  local bones=rec.bones
  if not bones then return nil end
  local idx=cfg.aim_bone or 1
  if idx<=7 then
    local name=AIM_BONE_NAMES[idx]
    local e=name and bones[name]
    if e then return e[1],e[2],name end
    return nil
  end
  local best,bd,bn
  for i=1,#CLOSEST_BONES do
    local e=bones[CLOSEST_BONES[i]]
    if e then
      local dx,dy=e[1]-v.mx,e[2]-v.my
      local d=dx*dx+dy*dy
      if not bd or d<bd then bd=d; best=e; bn=CLOSEST_BONES[i] end
    end
  end
  if best then return best[1],best[2],bn end
end

local function pick_target(v)
  local recs=build_recs(v)
  if TG.lobby then return nil end
  local fov=eff_fov()
  local fov2=fov*fov
  local range=cfg.aim_range or 20000
  local pri=cfg.aim_priority or 1
  local best,bs,bx,by,bb
  for i=1,#recs do
    local rec=recs[i]
    if rec.d<=range then
      local x,y,bn=aim_point(rec,v)
      if x then
        local dx,dy=x-v.mx,y-v.my
        local sd2=dx*dx+dy*dy
        if sd2<=fov2 then
          local score
          if pri==2 then score=rec.d
          elseif pri==3 then score=rec.hp or 100
          else score=sd2 end
          if not bs or score<bs then bs=score; best=rec; bx=x; by=y; bb=bn end
        end
      end
    end
  end
  if best then return best,bx,by,bb end
end

local function silent_hook(on)
  if SILENT.on==on then return end
  SILENT.on=on
  if not raycast then return end
  if on then
    if raycast.EnableSilentHook then pcall(raycast.EnableSilentHook) end
  else
    if raycast.ClearSilentTarget then pcall(raycast.ClearSilentTarget) end
    if raycast.DisableSilentHook then pcall(raycast.DisableSilentHook) end
  end
end

local function silent_clear()
  if raycast and raycast.ClearSilentTarget then pcall(raycast.ClearSilentTarget) end
end

local function aim_origin(v)
  if v.cpos then return v.cpos end
  local lp=v.lp
  if lp then
    local ok,h=pcall(getfield,lp,"HeadPosition")
    if ok and h then return h end
  end
end

local function run_aim(v)
  -- silent aim is the only aim method
  if not cfg.aim_on then AIML.target=nil; if SILENT.on then silent_hook(false) end; return end
  local key=bind.aim_key or 0
  local held=(cfg.aim_always and (cfg.aim_mode or 1)==1) or (key==0) or ekey(key)
  if not held or ui.capture then
    AIML.target=nil; AIML.ease_a=nil; AIML.ax=0; AIML.ay=0
    if SILENT.on then silent_hook(false) end
    return
  end
  local rec,x,y,bone=pick_target(v)
  if not rec then
    AIML.target=nil; AIML.ease_a=nil; AIML.ax=0; AIML.ay=0
    silent_clear()
    return
  end
  AIML.target=rec; AIML.x=x; AIML.y=y; AIML.bone=bone
  local bname=bone or "Head"
  if cfg.aim_mode==2 then
    -- mouse aim: nudge the cursor toward the target, higher smoothing = slower pull
    if SILENT.on then silent_hook(false) end
    local mx,my=mouse_pos()
    local dx,dy=x-mx,y-my
    local dd=math.sqrt(dx*dx+dy*dy)
    if dd<=(cfg.aim_dz or 0) then AIML.ax=0; AIML.ay=0; return end  -- deadzone
    -- soft pull: exponential approach, frame-rate independent. 0 = snap, 100 = very soft
    local soft=cfg.aim_soft or 10
    local alpha=1
    if soft>0 then
      alpha=1-math.exp(-utility.GetDeltaTime()*90/(1+soft*0.6))
    end
    local k=1
    if cfg.aim_ease then
      -- ease in: the pull starts gently on a new target and ramps up over 0.4s
      local t=now()
      if AIML.ease_a~=rec.tg.a then AIML.ease_a=rec.tg.a; AIML.ease_t=t end
      local pr=clamp((t-AIML.ease_t)/0.4,0,1)
      k=pr*pr*(3-2*pr)
    end
    -- carry sub-pixel remainders so slow pulls still move the cursor
    AIML.ax=(AIML.ax or 0)+dx*alpha*k
    AIML.ay=(AIML.ay or 0)+dy*alpha*k
    local ix=AIML.ax>=0 and math.floor(AIML.ax) or math.ceil(AIML.ax)
    local iy=AIML.ay>=0 and math.floor(AIML.ay) or math.ceil(AIML.ay)
    AIML.ax=AIML.ax-ix; AIML.ay=AIML.ay-iy
    if ix~=0 or iy~=0 then pcall(utility.MouseMove,ix,iy) end
    return
  end
  local origin=aim_origin(v)
  local tp=rec.wpos[bname] or rec.wpos.Head or rec.wpos.HumanoidRootPart
  if origin and tp then
    if not hit_roll(rec) then
      silent_clear()
    else
      silent_hook(true)
      local vn=Vector3 and Vector3.New
      if vn then
        pcall(raycast.SetSilentTarget,origin,vn(tp.X-origin.X,tp.Y-origin.Y,tp.Z-origin.Z))
      end
    end
  else
    silent_clear()
  end
end

local function draw_aim(v)
  if not cfg.aim_on then return end
  local fov=eff_fov()
  local x,y=v.mx,v.my
  local c=col.c_fov or {0.45,0.78,1,1}
  if cfg.aim_fovcircle then
    local style=cfg.aim_fovstyle or 1
    if style==1 then
      pcall(draw.Circle,x,y,fov,c,48,1.2)
    elseif style==2 then
      pcall(draw.Rect,x-fov,y-fov,fov*2,fov*2,c,0,1.2)
    elseif style==3 then
      pcall(draw.PolyClosed,{{x,y-fov},{x+fov,y},{x,y+fov},{x-fov,y}},c,1.2)
    else
      local l=fov*0.28
      local x0,y0,x1,y1=x-fov,y-fov,x+fov,y+fov
      pcall(draw.Line,x0,y0,x0+l,y0,c,1.2); pcall(draw.Line,x0,y0,x0,y0+l,c,1.2)
      pcall(draw.Line,x1,y0,x1-l,y0,c,1.2); pcall(draw.Line,x1,y0,x1,y0+l,c,1.2)
      pcall(draw.Line,x0,y1,x0+l,y1,c,1.2); pcall(draw.Line,x0,y1,x0,y1-l,c,1.2)
      pcall(draw.Line,x1,y1,x1-l,y1,c,1.2); pcall(draw.Line,x1,y1,x1,y1-l,c,1.2)
    end
  end
  if cfg.aim_tline then
    -- always on while the toggle is on: use the live aim target if aiming, otherwise
    -- preview the target the aimbot would pick (same FOV and range rules)
    local tx,ty
    if AIML.target and AIML.x then tx,ty=AIML.x,AIML.y
    else
      local rec,px,py=pick_target(v)
      if rec then tx,ty=px,py end
    end
    if tx then pcall(draw.Line, v.mx, v.my, tx, ty, col.c_tline or c, 1) end
  end
end

-- =========================================================================
-- CONFIG (session copy only; no file io)
-- =========================================================================
local CFG={last=0}
local SKEY="EGO_FRAMEBREAK_V1"
local function genv()
  local g=getgenv and getgenv()
  if type(g)~="table" then return nil end
  return g
end
function CFG.save()
  local g=genv(); if not g then return end
  local v={}; for k,val in pairs(cfg) do v[k]=val end
  local b={}; for k,val in pairs(bind) do b[k]=val end
  local c={}; for k,val in pairs(col) do c[k]={val[1],val[2],val[3],val[4] or 1} end
  g[SKEY]={v=v,b=b,c=c}
end
function CFG.load()
  local g=genv(); if not g then return end
  local d=g[SKEY]; if type(d)~="table" then return end
  if type(d.v)=="table" then
    for k,val in pairs(d.v) do
      if cfg[k]~=nil and type(val)==type(cfg[k]) then cfg[k]=val end
    end
  end
  if type(d.b)=="table" then
    for k,val in pairs(d.b) do
      local n=tonumber(val)
      if bind[k]~=nil and n then bind[k]=n end
    end
  end
  if type(d.c)=="table" then
    for k,val in pairs(d.c) do
      if col[k]~=nil and type(val)=="table" then
        local r1,g1,b1=tonumber(val[1]),tonumber(val[2]),tonumber(val[3])
        if r1 and g1 and b1 then col[k]={r1,g1,b1,tonumber(val[4]) or 1} end
      end
    end
  end
  -- re-clamp every row into its declared domain
  for _,tab in ipairs(SCHEMA) do for _,g2 in ipairs(tab.groups) do for _,it in ipairs(g2.items) do
    if it.t=="slider" and type(cfg[it.id])=="number" then
      cfg[it.id]=clamp(cfg[it.id],it.min,it.max)
    elseif it.t=="combo" and type(cfg[it.id])=="number" then
      cfg[it.id]=clamp(math.floor(cfg[it.id]),1,#it.items)
    end
  end end end
  cfg_dirty=false
end
CFG.load()

-- =========================================================================
-- HUD: watermark, keybind list and feature bar.
-- They read the menu's own state (cfg toggles + the bind table), so a feature
-- shows up the moment it is switched on and drops out when it is switched off.
-- No gameplay state is touched: these are overlays over the menu's settings.
-- =========================================================================
local hud_start=nil

local function hud_panel(x,y,w,h,ap,r)
  r=r or theme.round
  local e=mix(theme.accent,theme.accent2,0.5)
  for i=3,1,-1 do
    draw.RectFilled(x-i*2, y-i*1.5, w+i*4, h+i*3, {0,0,0,0.07*ap}, r+i*2)
  end
  draw.RectFilled(x,y,w,h, {theme.base[1],theme.base[2],theme.base[3],0.90*ap}, r)
  draw.Rect(x,y,w,h, a(theme.line,0.85*ap), r, 1)
  draw.Rect(x+3,y+3,w-6,h-6, a(theme.line,0.16*ap), r, 1)
  draw.RectFilled(x+r, y, w-r*2, 2, {e[1],e[2],e[3],0.9*ap}, 0)
  corners(x,y,w,h, 15, a(e,0.95*ap), 2, a(e,0.4*ap))
end
local function hud_head(x,y,w,idx,label)
  local nw=ts(idx,10)
  draw.RectFilled(x,y,nw+8,13, a(theme.accent,0.16), 2)
  draw.Text(x+4,y+2,idx, a(theme.accent,0.95), 10)
  local caps=string.upper(label); local hw=ts(caps,11)
  draw.Text(x+nw+15,y+1,caps, a(theme.faint,1), 11)
  local lx=x+nw+hw+23
  if lx<x+w then draw.Line(lx,y+9,x+w,y+9, a(theme.line,0.45), 1) end
end
-- drag grip: only while the menu is up, so the panels stay clean when closed
local function hud_grip(x,y,ap)
  if ui.appear<=0.9 then return end
  for r=0,1 do for c=0,1 do
    draw.RectFilled(x+c*4, y+r*4, 1.6,1.6, a(theme.faint,0.9*ap), 0)
  end end
end
-- Scratch state reused every frame instead of rebuilt
local HUD_S={feats={},w={},keys={},upv=-1,ups="",fpsv=-1,fpss=""}
local function hud_krow(rows,n,lb,v)
  n=n+1
  local r=rows[n]
  if not r then r={}; rows[n]=r end
  r[1]=lb; r[2]=vkname(v)
  return n
end
local function hud_key_rows()
  local rows=HUD_S.keys
  local n=0
  local v
  if cfg.aim_on then
    v=bind.aim_key or 0; if v~=0 then n=hud_krow(rows,n,"Aimbot",v) end
    v=bind.aim_toggle or 0; if v~=0 then n=hud_krow(rows,n,"Aim Toggle",v) end
  end
  v=bind.esp_toggle or 0
  if cfg.esp_on and v~=0 then n=hud_krow(rows,n,"ESP Toggle",v) end
  v=bind.menu_key or 0
  if v~=0 then n=hud_krow(rows,n,"Menu",v) end
  for i=#rows,n+1,-1 do rows[i]=nil end
  return rows
end
local function run_hud()
  local sw,sh=scr()
  hud_start=hud_start or now()
  local apm=approach("hud_mark", cfg.hud_mark and 1 or 0, 17)
  local apk=approach("hud_keys", cfg.hud_keys and 1 or 0, 15)
  local apb=approach("hud_bar",  cfg.hud_bar  and 1 or 0, 16)

  -- ------------------------------------------------------------- watermark
  if apm>0.01 then
    local fps=math.floor((utility.GetFPS and utility.GetFPS()) or 0)
    if not fps or fps<=0 then fps=math.floor(1/(_dt>0 and _dt or 0.016)) end
    local up=math.floor(now()-hud_start)
    local ut
    if up~=HUD_S.upv then
      HUD_S.upv=up
      ut = up<60 and string.format("%ds",up)
        or (up<3600 and string.format("%dm",math.floor(up/60)))
        or string.format("%dh%02dm",math.floor(up/3600),math.floor((up%3600)/60))
      HUD_S.ups=ut
    else
      ut=HUD_S.ups
    end
    local ft
    if fps~=HUD_S.fpsv then
      HUD_S.fpsv=fps
      ft=string.format("%d FPS",fps)
      HUD_S.fpss=ft
    else
      ft=HUD_S.fpss
    end
    local lw=ts("Ego",14); local pw2=ts("Framebreak",11)
    local fw=ts(ft,11); local uw=ts(ut,11)
    local ph=30
    local wpx=14+lw+5+8+6+pw2+10+1+10+fw+10+uw+14
    local wx=(cfg.hud_mark_x or -1)>=0 and cfg.hud_mark_x or (sw-wpx-16)
    local wy=(cfg.hud_mark_y or -1)>=0 and cfg.hud_mark_y or 14
    wx=clamp(wx,0,math.max(0,sw-wpx)); wy=clamp(wy,0,math.max(0,sh-ph))
    if inside(wx,wy,wpx,ph) and ui.m.click and not ui.drag and not ui.picker then
      ui.drag={k="hud_mark",ox=ui.m.x-wx,oy=ui.m.y-wy}; ui.m.click=false
    end
    hud_panel(wx,wy,wpx,ph,apm,3)
    hud_grip(wx+wpx-14,wy+2,apm)
    tmid(wx+14,wy,ph,"Ego", a(theme.text,1), 14)
    local dcx,dcy=wx+14+lw+5+4, wy+ph*0.5
    if draw.PolyFilled then pcall(draw.PolyFilled, {{dcx,dcy-4},{dcx+4,dcy},{dcx,dcy+4},{dcx-4,dcy}}, a(theme.accent,1))
    else draw.RectFilled(dcx-3,dcy-3,6,6, a(theme.accent,1), 1) end
    local px=dcx+4+6
    tmid(px,wy,ph,"Framebreak", a(theme.sub,1), 11)
    local gx=px+pw2+10
    draw.Line(gx,wy+8,gx,wy+ph-8, a(theme.line,0.6*apm), 1)
    local tx=gx+11
    local fc = fps>=100 and theme.ok or (fps>=45 and theme.text or theme.bad)
    tmid(tx,wy,ph,ft, a(fc,1), 11)
    tmid(tx+fw+10,wy,ph,ut, a(theme.faint,1), 11)
  end

  -- ---------------------------------------------------------- keybind list
  if apk>0.01 then
    local rows=hud_key_rows()
    if #rows>0 then
      local rh=21; local pw=178; local ph=40+#rows*rh
      local kx=(cfg.hud_keys_x or -1)>=0 and cfg.hud_keys_x or (sw-pw-16)
      local ky=(cfg.hud_keys_y or -1)>=0 and cfg.hud_keys_y or (sh-ph-18)
      kx=clamp(kx,0,math.max(0,sw-pw)); ky=clamp(ky,0,math.max(0,sh-ph))
      if inside(kx,ky,pw,ph) and ui.m.click and not ui.drag and not ui.picker then
        ui.drag={k="hud_keys",ox=ui.m.x-kx,oy=ui.m.y-ky}; ui.m.click=false
      end
      hud_panel(kx,ky,pw,ph,apk,4)
      hud_head(kx+13,ky+11,pw-26-(ui.appear>0.9 and 13 or 0),"01","Keybinds")
      hud_grip(kx+pw-16,ky+14,apk)
      for i,r in ipairs(rows) do
        local ry=ky+32+(i-1)*rh
        if i%2==0 then draw.RectFilled(kx+9,ry,pw-18,rh, {1,1,1,0.022*apk}, 0) end
        tmid(kx+14,ry,rh,r[1], a(theme.sub,1), 11)
        local kw=ts(r[2],10); local cw=kw+13; local ch=15
        local cx=kx+pw-13-cw; local cy=ry+(rh-ch)*0.5
        draw.RectFilled(cx,cy,cw,ch, a(theme.field,1), 2)
        draw.Rect(cx,cy,cw,ch, a(theme.line,1), 2, 1)
        tmid(cx,cy,ch,r[2], a(theme.text,1), 10)
      end
    end
  end

  -- ----------------------------------------------------------- feature bar
  if apb>0.01 then
    local feats=HUD_S.feats
    for i=#feats,1,-1 do feats[i]=nil end
    if cfg.aim_on then feats[#feats+1]="AIM" end
    if cfg.aim_on then feats[#feats+1]="SILENT" end
    if cfg.esp_on then feats[#feats+1]="ESP" end
    if #feats>0 then
      local gap=7; local pad=16; local ph=34
      local widths=HUD_S.w; local tot=pad*2+(#feats-1)*gap
      for i,lb in ipairs(feats) do
        local cw=math.max(48, ts(lb,10)+20); widths[i]=cw; tot=tot+cw
      end
      local bx=(cfg.hud_bar_x or -1)>=0 and cfg.hud_bar_x or (sw*0.5-tot*0.5)
      local by=(cfg.hud_bar_y or -1)>=0 and cfg.hud_bar_y or (sh-ph-18)
      bx=clamp(bx,0,math.max(0,sw-tot)); by=clamp(by,0,math.max(0,sh-ph))
      if inside(bx,by,tot,ph) and ui.m.click and not ui.drag and not ui.picker then
        ui.drag={k="hud_bar",ox=ui.m.x-bx,oy=ui.m.y-by}; ui.m.click=false
      end
      hud_panel(bx,by,tot,ph,apb,4)
      hud_grip(bx+tot-14,by+2,apb)
      local e=mix(theme.accent,theme.accent2,0.5)
      draw.RectFilled(bx+pad-2,by+ph-2,tot-(pad-2)*2,2, {e[1],e[2],e[3],0.9*apb}, 1)
      local px=bx+pad
      for i,lb in ipairs(feats) do
        local cw=widths[i]; local cx=px+cw*0.5
        draw.CircleFilled(cx,by+11,2.4, a(e,0.95*apb), 12)
        local tw=ts(lb,10)
        draw.Text(cx-tw*0.5,by+17,lb, a(theme.text,0.95*apb), 10)
        if i<#feats then
          local sx=px+cw+gap*0.5
          draw.Line(sx,by+9,sx,by+ph-10, a(theme.line,0.5*apb), 1)
        end
        px=px+cw+gap
      end
    end
  end

  -- Deferred whole-window grab queued by draw_menu. The panels above claim the
  -- press first, so this only fires when the click landed on the menu itself.
  local g=ui.win_grab
  ui.win_grab=nil
  if g and ui.m.click and not ui.drag and not ui.picker then
    ui.drag={k="win",ox=g.ox,oy=g.oy}; ui.m.click=false
  end
end

