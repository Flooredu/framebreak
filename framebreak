-- FRAME LOOP
-- =========================================================================
local UNLOADED=false
function OnFrame()
  if UNLOADED then return end
  if not (draw and utility and entity and camera and input) then return end
  _dt=utility.GetDeltaTime and utility.GetDeltaTime() or 0.016
  if not _dt or _dt<=0 or _dt>0.2 then _dt=0.016 end
  FRAME=FRAME+1
  theme.opacity=1
  if cfg.accent_chroma then
    local h=now()*0.15
    theme.accent=hsv(h,0.7,1)
    theme.accent2=hsv(h+0.11,0.7,1)
  else
    theme.accent=col.c_accent or theme.accent
    theme.accent2=theme.accent2_base
  end

  update_input()
  ui.appear=approach("appear", ui.open and 1 or 0, 14)

  local v=view()
  pcall(run_esp,v)
  pcall(run_aim,v)
  pcall(draw_aim,v)
  if ui.appear>0.01 then pcall(draw_menu) end
  theme.opacity=1
  pcall(run_hud)

  if cfg_dirty then
    local t=now()
    if t-CFG.last>=1 then CFG.last=t; CFG.save(); cfg_dirty=false end
  end
end

-- Unload: drop the silent-aim hook, turn the gameplay features off, persist the
-- profile and stop drawing. Everything was registered by the host, so the frame
-- callback is the only thing left to neutralise.
UNLOAD=function()
  if UNLOADED then return end
  UNLOADED=true
  if SILENT.on then silent_hook(false) end
  pcall(silent_clear)
  pcall(CFG.save)  -- persist the user's real settings before switching things off
  cfg.aim_on=false; cfg.esp_on=false
  cfg_dirty=false
  ui.open=false
  ui.drag=nil; ui.picker=nil; ui.capture=nil
